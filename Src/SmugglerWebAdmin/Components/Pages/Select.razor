@page "/select"
@attribute [Authorize]
@layout SelectLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SmugglerWebAdmin.Components.Layout
@using SmugglerWebAdmin.Data
@using SmugglerWebAdmin.Services

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IRegionService RegionService
@inject ITokenService TokenService
@inject IJSRuntime JS

<PageTitle>환경 선택</PageTitle>

@if (_isLoading)
{
    <div class="text-center text-secondary py-5">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        로딩 중...
    </div>
}
else if (_serviceGroups.Count == 0)
{
    <p class="text-center text-secondary py-5">접근 가능한 환경이 없습니다.</p>
}
else
{
    foreach (var service in _serviceGroups)
    {
        <div class="service-group mb-4">
            <div class="service-group-title">@service.Service.DisplayName</div>
            @foreach (var region in service.Regions)
            {
                <div class="region-group mb-3">
                    <div class="region-group-title">@region.Region.DisplayName</div>
                    <div class="region-env-list">
                        @foreach (var env in region.Environments)
                        {
                            <button class="env-btn"
                                    @onclick="async () => await OnEnvClick(env)">
                                @env.DisplayName
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@if (!string.IsNullOrEmpty(_alertMessage))
{
    <div class="alert alert-warning mt-3 text-center small">@_alertMessage</div>
}

@code {
    private bool _isLoading = true;
    private List<ServiceGroup> _serviceGroups = new();
    private ApplicationUser? _currentUser;
    private string? _alertMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claimsUser = authState.User;

        if (claimsUser.Identity?.IsAuthenticated == true)
        {
            _currentUser = await UserManager.GetUserAsync(claimsUser);
        }

        if (_currentUser is not null)
        {
            await LoadPermittedGroupsAsync(_currentUser.Id);
        }

        _isLoading = false;
    }

    private async Task LoadPermittedGroupsAsync(string userId)
    {
        var l1Ids = (await RegionService.GetPermittedServiceIdsAsync(userId)).ToHashSet();
        var l2Ids = (await RegionService.GetPermittedServiceRegionIdsAsync(userId)).ToHashSet();

        var services = await RegionService.GetAllActiveServicesAsync();

        foreach (var service in services)
        {
            var allRegions = await RegionService.GetRegionsByServiceAsync(service.Id);
            var regionGroups = new List<RegionGroup>();

            foreach (var region in allRegions)
            {
                // L1 권한이 있으면 전체 리전 포함, 없으면 L2 권한 있는 리전만 포함
                if (!l1Ids.Contains(service.Id) && !l2Ids.Contains(region.Id))
                {
                    continue;
                }

                var envs = await RegionService.GetEnvironmentsByRegionAsync(region.Id);
                if (envs.Any())
                {
                    regionGroups.Add(new RegionGroup(region, envs.ToList()));
                }
            }

            if (regionGroups.Count > 0)
            {
                _serviceGroups.Add(new ServiceGroup(service, regionGroups));
            }
        }
    }

    private async Task OnEnvClick(RegionEnvironment env)
    {
        if (_currentUser is null)
        {
            return;
        }

        if (string.IsNullOrEmpty(env.ToolUrl))
        {
            _alertMessage = $"[{env.DisplayName}] 환경은 아직 준비 중입니다.";
            return;
        }

        _alertMessage = null;

        // JWT 클레임용: 사용자가 접근 가능한 모든 환경 ID 수집
        var l1Ids = (await RegionService.GetPermittedServiceIdsAsync(_currentUser.Id)).ToHashSet();
        var l2Ids = (await RegionService.GetPermittedServiceRegionIdsAsync(_currentUser.Id)).ToHashSet();
        var permittedEnvIds = _serviceGroups
            .SelectMany(s => s.Regions)
            .SelectMany(r => r.Environments)
            .Select(e => e.Id)
            .ToList();

        var token = TokenService.GenerateToken(_currentUser, permittedEnvIds);
        var redirectUrl = $"{env.ToolUrl.TrimEnd('/')}?token={Uri.EscapeDataString(token)}";
        await JS.InvokeVoidAsync("open", redirectUrl, "_blank");
    }

    private sealed record RegionGroup(ServiceRegion Region, List<RegionEnvironment> Environments);
    private sealed record ServiceGroup(Service Service, List<RegionGroup> Regions);
}
