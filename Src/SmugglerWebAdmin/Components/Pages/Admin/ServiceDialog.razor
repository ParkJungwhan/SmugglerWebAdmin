@using MudBlazor
@using static SmugglerWebAdmin.Components.Pages.Admin.Regions

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Name" Label="내부 식별자 (Name)" Immediate="true" Class="mb-3" />
        <MudTextField @bind-Value="DisplayName" Label="표시명 (DisplayName)" Immediate="true" Class="mb-3" />
        @if (IsEdit)
        {
            <MudCheckBox @bind-Value="IsActive" Label="활성" Color="Color.Success" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(string.IsNullOrWhiteSpace(Name) || string.IsNullOrWhiteSpace(DisplayName))"
                   OnClick="Submit">
            저장
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string DisplayName { get; set; } = "";
    [Parameter] public bool IsActive { get; set; } = true;
    [Parameter] public bool IsEdit { get; set; }

    private void Submit() =>
        MudDialog.Close(DialogResult.Ok(new ServiceDialogResult(Name.Trim(), DisplayName.Trim(), IsActive)));

    private void Cancel() => MudDialog.Cancel();
}
