@page "/admin/users"
@attribute [Authorize]
@layout AppLayout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SmugglerWebAdmin.Components.Layout
@using SmugglerWebAdmin.Data
@using SmugglerWebAdmin.Services

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IAdminService AdminService
@inject NavigationManager NavigationManager

<AppShell>
    <PageTitle>유저 관리</PageTitle>

    @if (_isLoading)
    {
        <div class="d-flex justify-center align-center" style="min-height: 200px;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        <div class="d-flex align-center justify-space-between mb-4">
            <MudText Typo="Typo.h5">유저 관리</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(_activeChanges.Count == 0 || _isSaving)"
                       OnClick="SaveActiveChangesAsync">
                @(_isSaving ? "저장 중..." : $"활성 저장{(_activeChanges.Count > 0 ? $" ({_activeChanges.Count})" : "")}")
            </MudButton>
        </div>

        <MudTable Items="_users" Hover="true" Striped="true" Dense="true" Elevation="2">
            <HeaderContent>
                <MudTh>이메일</MudTh>
                <MudTh>가입일</MudTh>
                <MudTh Style="text-align:center">어드민</MudTh>
                <MudTh Style="text-align:center">슈퍼어드민</MudTh>
                <MudTh Style="text-align:center">활성</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd Style="text-align:center">
                    @if (context.IsAdmin || context.IsSuperAdmin)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Size="Size.Small" />
                    }
                </MudTd>
                <MudTd Style="text-align:center">
                    @if (context.IsSuperAdmin)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Secondary" Size="Size.Small" />
                    }
                </MudTd>
                <MudTd Style="text-align:center">
                    <MudCheckBox Value="@GetIsActive(context)"
                                 ValueChanged="@((bool v) => MarkActiveChange(context, v))"
                                 Color="Color.Success" Dense="true" />
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="@(() => NavigationManager.NavigateTo($"/admin/users/{context.Id}"))">
                        편집
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</AppShell>

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private List<ApplicationUser> _users = new();

    // userId → 변경된 IsActive 값 (저장 전 대기 중인 변경)
    private Dictionary<string, bool> _activeChanges = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var currentUser = await UserManager.GetUserAsync(authState.User);
        if (currentUser is null || (!currentUser.IsAdmin && !currentUser.IsSuperAdmin))
        {
            NavigationManager.NavigateTo("/select");
            return;
        }

        _users = await AdminService.GetAllUsersAsync();
        _isLoading = false;
    }

    private bool GetIsActive(ApplicationUser user)
    {
        if (_activeChanges.TryGetValue(user.Id, out var pending))
            return pending;
        return user.IsActive;
    }

    private void MarkActiveChange(ApplicationUser user, bool value)
    {
        if (value == user.IsActive)
            _activeChanges.Remove(user.Id);
        else
            _activeChanges[user.Id] = value;
    }

    private async Task SaveActiveChangesAsync()
    {
        if (_activeChanges.Count == 0) return;
        _isSaving = true;

        foreach (var (userId, isActive) in _activeChanges)
        {
            await AdminService.SetActiveAsync(userId, isActive);
            var user = _users.Find(u => u.Id == userId);
            if (user is not null)
                user.IsActive = isActive;
        }

        _activeChanges.Clear();
        _isSaving = false;
    }
}
