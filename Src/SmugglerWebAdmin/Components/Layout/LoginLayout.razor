@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent>
        <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1rem;">
            <MudPaper Elevation="4" Style="width: 100%; max-width: 420px; padding: 2rem;">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-5">
                    <strong style="color: var(--mud-palette-primary);">Smuggler</strong>
                    <span> Admin</span>
                </MudText>
                @Body
            </MudPaper>
        </div>
    </MudMainContent>
</MudLayout>
