@page "/entry"
@using SmugglerWebCommon.Auth.Models
@using SmugglerWebTool.Services.Auth

@inject IRegionHandoffReader RegionHandoffReader
@inject IRegionSessionService RegionSessionService
@inject NavigationManager NavigationManager

<PageTitle>Tool Entry</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Class="pa-6" Elevation="4">
        <MudText Typo="Typo.h5" Class="mb-3">SmugglerWebTool Entry</MudText>

        @if (_context is null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">유효하지 않거나 만료된 진입 토큰입니다.</MudAlert>
            <MudButton Variant="Variant.Outlined" OnClick="GoHome">Home</MudButton>
        }
        else
        {
            <MudStack Spacing="1" Class="mb-4">
                <MudText>User: @_context.Email</MudText>
                <MudText>Region: @_context.RegionCode</MudText>
                <MudText>Role: @_context.Role</MudText>
                <MudText>Expires(Utc): @_context.ExpiresAtUtc</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoDashboard">대시보드로 이동</MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    private RegionAccessContext? _context;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Token) && RegionHandoffReader.TryRead(Token, out var context) && context is not null)
        {
            _context = context;
            RegionSessionService.Set(HttpContext, context);
        }
        else if (RegionSessionService.TryGet(HttpContext, out var sessionContext) && sessionContext is not null)
        {
            _context = sessionContext;
        }
        else
        {
            _context = null;
        }
    }

    private void GoHome() => NavigationManager.NavigateTo("/");
    private void GoDashboard() => NavigationManager.NavigateTo("/");
}
