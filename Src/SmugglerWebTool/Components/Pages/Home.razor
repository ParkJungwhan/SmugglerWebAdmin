@page "/"
@using Microsoft.AspNetCore.Authorization
@using SmugglerWebCommon.Auth.Models
@using SmugglerWebTool.Services.Auth

@attribute [Authorize]

@inject IRegionSessionService RegionSessionService

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Class="pa-6" Elevation="4">
        <MudText Typo="Typo.h4" Class="mb-3">Dashboard</MudText>

        @if (_context is null)
        {
            <MudAlert Severity="Severity.Warning">현재 연결된 리전 컨텍스트가 없습니다. SelectWeb에서 리전을 선택해 진입하세요.</MudAlert>
        }
        else
        {
            <MudStack Spacing="1">
                <MudText>User: @_context.Email</MudText>
                <MudText>Region: @_context.RegionCode</MudText>
                <MudText>Role: @_context.Role</MudText>
                <MudText>Session Expires(Utc): @_context.ExpiresAtUtc</MudText>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    private RegionAccessContext? _context;

    protected override void OnParametersSet()
    {
        _context = RegionSessionService.TryGet(HttpContext, out var context)
            ? context
            : null;
    }
}
