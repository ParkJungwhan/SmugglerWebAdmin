@page "/regions"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SmugglerSelectWeb.Data
@using SmugglerSelectWeb.Services.Auth
@using SmugglerWebCommon.Auth.Models
@attribute [Authorize]

@inject IRegionAccessService RegionAccessService
@inject IRegionHandoffTokenService RegionHandoffTokenService
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<PageTitle>Region Select</PageTitle>

<h1>운영 리전 선택</h1>
<p>권한이 있는 리전을 선택하면 SmugglerWebTool로 이동합니다.</p>

@if (_regions.Count == 0)
{
    <p>조회 가능한 리전이 없습니다.</p>
}
else
{
    <div class="list-group">
        @foreach (var region in _regions)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">@region.RegionName</div>
                    <div class="text-muted">@region.RegionCode</div>
                </div>
                @if (region.CanAccess)
                {
                    <button class="btn btn-primary" @onclick="() => EnterRegionAsync(region)">입장</button>
                }
                else
                {
                    <span class="badge text-bg-secondary">권한 없음</span>
                }
            </div>
        }
    </div>
}

@code {
    private readonly List<RegionOption> _regions = [];

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var regions = await RegionAccessService.GetAvailableRegionsAsync(HttpContext.User);
        _regions.AddRange(regions);
    }

    private async Task EnterRegionAsync(RegionOption region)
    {
        var dbUser = await UserManager.GetUserAsync(HttpContext.User);

        var userId = dbUser?.Id ?? HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var email = dbUser?.Email ?? HttpContext.User.FindFirstValue(ClaimTypes.Email) ?? HttpContext.User.Identity?.Name ?? string.Empty;
        var role = HttpContext.User.FindFirstValue(ClaimTypes.Role) ?? (dbUser?.AdminType is > 0 ? $"Admin-{dbUser.AdminType}" : "Viewer");

        var token = RegionHandoffTokenService.CreateToken(userId, email, role, region.RegionCode, TimeSpan.FromMinutes(30));
        var toolBaseUrl = Configuration["Smuggler:ToolBaseUrl"] ?? "https://localhost:7152";
        var destination = $"{toolBaseUrl.TrimEnd('/')}/entry?token={Uri.EscapeDataString(token)}";

        NavigationManager.NavigateTo(destination, forceLoad: true);
    }
}
