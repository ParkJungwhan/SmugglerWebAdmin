@page "/regions"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SmugglerSelectWeb.Data
@using SmugglerSelectWeb.Services.Auth
@using SmugglerWebCommon.Auth.Models
@attribute [Authorize]

@inject IRegionAccessService RegionAccessService
@inject IRegionHandoffTokenService RegionHandoffTokenService
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<PageTitle>Region Select</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4" Color="Color.Inherit">Region Selection</MudText>
        <form action="/Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="Account/Login" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout">
                Logout
            </MudButton>
        </form>
    </MudStack>

    @if (_groups.Count == 0)
    {
        <MudAlert Severity="Severity.Info">조회 가능한 리전이 없습니다.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var group in _groups)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="6" Style="background-color:var(--mud-palette-primary)">
                        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-3" Color="Color.Inherit">Service @group.X - Region @group.Y</MudText>
                        <MudStack Spacing="2">
                            @foreach (var region in group.Regions)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Disabled="@(!region.CanAccess)" OnClick="() => EnterRegionAsync(region)">
                                    @region.RegionName
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private readonly List<RegionGroup> _groups = [];

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var regions = (await RegionAccessService.GetAvailableRegionsAsync(HttpContext.User)).ToList();
        _groups.Clear();

        if (regions.Count == 0)
        {
            return;
        }

        var grouped = regions
            .GroupBy(region => GetGroupKey(region.RegionCode))
            .OrderBy(group => group.Key.X)
            .ThenBy(group => group.Key.Y);

        foreach (var group in grouped)
        {
            _groups.Add(new RegionGroup(
                group.Key.X,
                group.Key.Y,
                group.OrderBy(region => region.RegionCode).ToList()));
        }
    }

    private static (int X, int Y) GetGroupKey(int regionCode)
    {
        var x = regionCode / 1000;
        var y = (regionCode / 10) % 10;
        return (x, y);
    }

    private async Task EnterRegionAsync(RegionOption region)
    {
        var dbUser = await UserManager.GetUserAsync(HttpContext.User);

        var userId = dbUser?.Id ?? HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var email = dbUser?.Email ?? HttpContext.User.FindFirstValue(ClaimTypes.Email) ?? HttpContext.User.Identity?.Name ?? string.Empty;
        var role = HttpContext.User.FindFirstValue(ClaimTypes.Role) ?? (dbUser?.AdminType is > 0 ? $"Admin-{dbUser.AdminType}" : "Viewer");

        var token = RegionHandoffTokenService.CreateToken(userId, email, role, region.RegionCode, TimeSpan.FromMinutes(30));
        var fallbackEntryUrl = $"{(Configuration["Smuggler:ToolBaseUrl"] ?? "https://localhost:7152").TrimEnd('/')}/entry";
        var baseDestination = string.IsNullOrWhiteSpace(region.Address) ? fallbackEntryUrl : region.Address.Trim();
        var destination = BuildDestinationWithToken(baseDestination, token);

        NavigationManager.NavigateTo(destination, forceLoad: true);
    }

    private static string BuildDestinationWithToken(string baseDestination, string token)
    {
        var encodedToken = Uri.EscapeDataString(token);

        if (baseDestination.EndsWith("?", StringComparison.Ordinal) || baseDestination.EndsWith("&", StringComparison.Ordinal))
        {
            return $"{baseDestination}token={encodedToken}";
        }

        var separator = baseDestination.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{baseDestination}{separator}token={encodedToken}";
    }

    private sealed record RegionGroup(int X, int Y, IReadOnlyList<RegionOption> Regions);
}
